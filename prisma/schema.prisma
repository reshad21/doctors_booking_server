generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum DoctorType {
  INDIVIDUAL
  ORGANIZATION_ASSIGNED
}

enum Status {
  ACTIVE
  INACTIVE
}

enum PatientStatus {
  NEW
  OLD
  REPORT
}

model FeatureToggle {
  id             String   @id @default(uuid())
  featureId      String
  doctorId       String? // Optional: for doctor-specific toggles
  organizationId String? // Optional: for org-specific toggles
  staffId        String? // Optional: for staff-specific toggles
  enabled        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  feature      Feature       @relation(fields: [featureId], references: [id])
  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  staff        Staff?        @relation(fields: [staffId], references: [id])

  @@unique([featureId, doctorId])
  @@unique([featureId, organizationId])
  @@unique([featureId, staffId])
}

model Feature {
  id        String          @id @default(uuid())
  key       String          @unique // e.g. CREATE_PRESCRIPTION
  name      String // Human-readable label
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  toggles   FeatureToggle[]
}

model RouteAccess {
  id             String   @id @default(uuid())
  path           String // e.g. "/dashboard", "/patients", "/billing"
  name           String // e.g. "Dashboard"
  doctorId       String? // specific to doctor
  organizationId String? // specific to organization
  allowed        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  doctor       Doctor?       @relation(fields: [doctorId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  Staff        Staff?        @relation(fields: [staffId], references: [id])
  staffId      String?

  @@unique([path, doctorId])
  @@unique([path, organizationId])
}

model Doctor {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  phone          String
  image          String?
  password       String
  type           DoctorType    @default(INDIVIDUAL)
  status         Status        @default(ACTIVE)
  organizationId String? // nullable for phase 1
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  staff                             Staff[]
  patients                          Patient[]
  chamber                           Chamber[]
  prescription                      Prescription[]
  featureToggle                     FeatureToggle[]
  routeAccess                       RouteAccess[]
  visit                             Visit[]
  DisplayNoticeTable                DisplayNoticeTable[]
  PrescriptionUITable               PrescriptionUITable[]
  WatchVideo                        WatchVideo[]
  AdviceTable                       AdviceTable[]
  OnExaminationsInput               OnExaminationsInput[]
  ChiefComplaintInput               ChiefComplaintInput[]
  InvestigationInput                InvestigationInput[]
  DiagnosisInput                    DiagnosisInput[]
  MedicineDosagesInput              MedicineDosagesInput[]
  MedicineTimeInput                 MedicineTimeInput[]
  MedicineDosagesFrequencyNameInput MedicineDosagesFrequencyNameInput[]
  MedicineDosagesFrequencyDayInput  MedicineDosagesFrequencyDayInput[]
  PrescriptionSetup                 PrescriptionSetup[]
  PrescriptionFooter                PrescriptionFooter[]
  HistoryInput                      HistoryInput[]
  AdviceInput                       AdviceInput[]
  NextVisitInput                    NextVisitInput[]
  ClinicalNotesTemplate             ClinicalNotesTemplate[]
  TreatmentPlanInput                TreatmentPlanInput[]
  CoMorbiditiesInput                CoMorbiditiesInput[]
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  logo      String?
  address   String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors       Doctor[]
  staff         Staff[]
  featureToggle FeatureToggle[]
  routeAccess   RouteAccess[]
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String
  image     String?
  password  String
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorId String? // assigned to individual doctor
  doctor   Doctor? @relation(fields: [doctorId], references: [id])

  organizationId String? // assigned to organization
  organization   Organization?   @relation(fields: [organizationId], references: [id])
  featureToggle  FeatureToggle[]
  routeAccess    RouteAccess[]
}

enum VisitStatus {
  VISITED
  NOT_VISITED
}

model Patient {
  id             String         @id @default(uuid())
  name           String
  phoneNumber    String
  email          String?
  age            String
  gender         String
  weight         String
  discountAmount Float          @default(0)
  status         PatientStatus
  visitStatus    VisitStatus    @default(NOT_VISITED)
  visitedAt      DateTime?
  doctorId       String
  isArrived      Boolean        @default(false)
  doctor         Doctor         @relation(fields: [doctorId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  chamberId      String?
  time           String?
  chamber        Chamber?       @relation(fields: [chamberId], references: [id])
  prescription   Prescription[]
  visit          Visit[]
}

model Visit {
  id        String   @id @default(uuid())
  patientId String
  doctorId  String
  chamberId String?
  visitDate DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type PatientStatus
  fee  Int

  patient Patient  @relation(fields: [patientId], references: [id])
  doctor  Doctor   @relation(fields: [doctorId], references: [id])
  chamber Chamber? @relation(fields: [chamberId], references: [id])
}

model Chamber {
  id                 String               @id @default(uuid())
  name               String
  address            String
  oldPatientFee      String
  newPatientFee      String
  reportFee          String
  status             Status               @default(ACTIVE)
  startTime          String?
  endTime            String?
  day                String?
  doctorId           String
  doctor             Doctor               @relation(fields: [doctorId], references: [id])
  patients           Patient[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  visit              Visit[]
  PrescriptionSetup  PrescriptionSetup[]
  PrescriptionFooter PrescriptionFooter[]
}

model Prescription {
  id             String           @id @default(uuid())
  prescriptionNo String           @default("GENERATING")
  patientId      String
  doctorId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  patient        Patient          @relation(fields: [patientId], references: [id])
  doctor         Doctor           @relation(fields: [doctorId], references: [id])
  medicines      Medicine[]
  chiefComplaint ChiefComplaint[]
  onExaminations OnExaminations[]
  diagnosis      Diagnosis[]
  investigation  Investigation[]
  advice         Advice[]
  history        History[]
  nextVisit      NextVisit[]
  treatmentPlan  TreatmentPlan[]
  coMorbidities  CoMorbidities[]
}

model Medicine {
  id             String           @id @default(uuid())
  prescriptionId String
  prescription   Prescription     @relation(fields: [prescriptionId], references: [id])
  medicineName   String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  DosageSchedule DosageSchedule[]
}

model DosageSchedule {
  id         String   @id @default(uuid())
  dosage     String?
  day        String?
  time       String?
  comment    String?
  medicineId String
  medicine   Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  dosageNotes DosageNote[]
}

model DosageNote {
  id       String @id @default(uuid())
  qty      String
  unit     String
  freq     String
  freqUnit String

  dosageScheduleId String
  dosageSchedule   DosageSchedule @relation(fields: [dosageScheduleId], references: [id], onDelete: Cascade)
}

model ChiefComplaint {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model OnExaminations {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Diagnosis {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Investigation {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model History {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Advice {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model NextVisit {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model TreatmentPlan {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model CoMorbidities {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  description    String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model MedicineTimeInput {
  id        String   @id @default(uuid())
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}

model MedicineDosagesInput {
  id        String   @id @default(uuid())
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}

model MedicineDosagesFrequencyNameInput {
  id        String   @id @default(uuid())
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
}

model MedicineDosagesFrequencyDayInput {
  id        String   @id @default(uuid())
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id])
